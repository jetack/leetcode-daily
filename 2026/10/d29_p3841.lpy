(require lispy.macros *)
(require leetcode *)

(from leetcode *)


(def solution [n edges s queries]
  (= adj [[] for _ in (range n)])
  (for [u v] edges
    (.append (sub adj u) v)
    (.append (sub adj v) u))
  
  (def parse-query [q]
    (= [t a b] (.split q))
    (return [t
             (int a)
             (ife (== t "update") b (int b))]))

  (def build-hld []
    (= parent (* [-1] n))
    (= size (* [1] n))
    (= heavy (* [None] n))
    (= depth (* [0] n))
    
    (def dfs1 [u p d]
      (= (sub parent u) p)
      (= (sub depth u) d)
      (= max-size 0)
      (for v (sub adj u)
        (when (== v p)
          (continue))
        (dfs1 v u (inc d))
        (+= (sub size u) (sub size v))
        (when (> (sub size v) max-size)
          (= max-size (sub size v))
          (= (sub heavy u) v))))

    (dfs1 0 -1 0)

    (= head (* [-1] n))
    (= pos (* [None] n))

    (= timer 0)
    (def dfs2 [u r]
      (nonlocal timer)
      (= (sub pos u) timer)
      (= (sub head u) r)
      (+= timer 1)

      (when (is-not (sub heavy u) None)
        (dfs2 (sub heavy u) r))
      
      (for v (sub adj u)
        (when (or (== v (sub parent u))
                  (== v (sub heavy u)))
          (continue))
        (dfs2 v v)))

    (dfs2 0 0)

    (return [pos head parent depth]))

  (def alpha2bit [a]
    (return (** 2 (- (ord a) (ord "a")))))

  (= [pos head parent depth] (build-hld))

  (def build-seg [s pos]
    (= result (* [0] (* 2 n)))
    (for [i a] (enumerate s)
      (= (sub result (+ n (sub pos i))) (alpha2bit a)))
    (for i (range (dec n) -1 -1)
      (= (sub result i) (^ (sub result (* 2 i))
                           (sub result (inc (* 2 i))))))
    (return result))

  (= seg (build-seg s pos))

  (def query-seg [seg pos i j]
    (= p (+ n (sub pos i)))
    (= q (+ n (sub pos j)))
    (= result 0)
    
    (while (<= p q)
      (when (& p 1)
        (^= result (sub seg p))
        (+= p 1))
      (when (not (& q 1))
        (^= result (sub seg q))
        (-= q 1))
      (//= p 2)
      (//= q 2))
    (return result))

  (def update-seg [seg pos i v]
    (= j (+ n (sub pos i)))
    (= (sub seg j) (alpha2bit v))
    (while j
      (//= j 2)
      (= (sub seg j) (^ (sub seg (* 2 j))
                        (sub seg (inc (* 2 j)))))))

  (def query-path [u v parent depth head pos seg]
    (= result 0)
    (while (!= (sub head u) (sub head v))
      (when (< (sub depth (sub head u)) (sub depth (sub head v)))
        (= [u v] [v u]))
      (^= result (query-seg seg pos (sub head u) u))
      (= u (sub parent (sub head u))))
    (when (> (sub depth u) (sub depth v))
      (= [u v] [v u]))
    (^= result (query-seg seg pos u v))
    (return result))

  (def judge [n]
    (return (-> n
                (bin)
                (sub [: 2 _])
                (->> (map int))
                (sum)
                (< 2)
                )))

  (= rst [])
  (for q queries
    (= [t a b] (parse-query q))
    (cond (== t "update")
          (update-seg seg pos a b)
          (== t "query")
          (.append rst
                   (-> (query-path a b parent depth head pos seg)
                       (judge)))))
  (return rst)
  )

(leetcode palindromePath
          [(, 3 [[0,1],[1,2]] "aac" ["query 0 2","update 1 b","query 0 2"])
           [True False]])
