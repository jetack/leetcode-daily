(require lispy.macros *)
(require leetcode *)

(from leetcode *)

(def solution [s]
  (= result 0)
  (for i (range 0 (len s) 2)
    (when (!= (sub s i) (sub s (inc i)))
      (+= result 1)))
  (return result))

;; opus: compare the even and odd halves pairwise in C with map(ne, ...)
(def solution [s]
  (from operator [ne])
  (return (-> (map ne (sub s [: 0 _ 2]) (sub s [: 1 _ 2]))
              sum)))

(leetcode minChanges
         (, (, "1001")
            2)
         (, (, "10")
            1)
         (, (, "0000")
            0))
