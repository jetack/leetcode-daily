(require lispy.macros *)
(require leetcode *)

(from leetcode *)

(def solution [arr]
  (= acc 0)
  (= past-evens 0)
  (= past-odds 0)
  (= result 0)
  (for n arr
    (+= acc n)
    (if (& acc 1)
        (do (+= past-odds 1)
            (+= result (+ past-evens 1)))
        (do (+= past-evens 1)
            (+= result past-odds))))
  (return (% result
             1_000_000_007)))

(leetcode numOfSubarrays
          (, (, [1,3,5])
             4)
          (, (, [2,4,6])
             0)
          (, (, [1,2,3,4,5,6,7])
             16))
