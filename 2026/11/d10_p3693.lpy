(require lispy.macros *)
(require leetcode *)

(from leetcode *)

;;; dijkstra
(def solution [n costs]
  ;; time limit
  (= mem [[0 0]])
  (while (and mem
              (!= (sub mem 0 1) n))
    (= [d i] (heappop mem))
    (for j (range (+ i 1) (inc (min (+ i 3) n)))
      (heappush mem [(+ d (sub costs (dec j)) (** (- j i) 2)) j])))
  (return (sub mem 0 0)))

(def solution [n costs]
  ;; opus advice: visit check
  (= mem [[0 0]])
  (= visited (* [0] n))
  (while (and mem
              (!= (sub mem 0 1) n))
    (= [d i] (heappop mem))
    (when (sub visited i)
      (continue))
    (= (sub visited i) 1)
    (for j (range (+ i 1) (inc (min (+ i 3) n)))
      (heappush mem [(+ d (sub costs (dec j)) (** (- j i) 2)) j])))
  (return (sub mem 0 0)))

;;; dp
(def solution [n costs]
  ;; works
  (= dp (* [(float "inf")] (+ n 1)))
  (= costs (+ [0] costs))
  (= (sub dp 0) 0)
  (for j (range (+ n 1))
    (for i (range (max 0 (- j 3)) j)
      (= val (+ (sub dp i) (sub costs j) (** (- j i) 2)))
      (when (< val (sub dp j))
        (= (sub dp j) val))))
  (return (sub dp -1)))

(def solution [n costs]
  ;; optimized by Opus 5.5
  ;; dp[j] only reads dp[j-3..j-1], so keep three rolling values;
  ;; costs[j] is shared by all three jumps into j, so it moves out of the min
  (= inf (float "inf"))
  (= [a b c] (, inf inf 0))  ; dp[-2], dp[-1], dp[0]
  (for x costs
    (= [a b c] (, b c (+ x (min (+ a 9) (+ b 4) (+ c 1))))))
  (return c))

(leetcode climbStairs
          (, (, 4 [1 2 3 4])
             13)
          (, (, 4 [5 1 6 2])
             11)
          (, (, 3 [9 8 3])
             12)
          )
