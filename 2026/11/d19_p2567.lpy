(require lispy.macros *)
(require leetcode *)

(from leetcode *)

(def solution [nums]
  (nums.sort)
  (= a0 (sub nums 0))
  (= a1 (sub nums 1))
  (= a2 (sub nums 2))
  (= a-1 (sub nums -1))
  (= a-2 (sub nums -2))
  (= a-3 (sub nums -3))
  (return (- a-1
             a0
             (max (- a2 a0)
                  (- a-1 a-3)
                  (+ (- a1 a0)
                     (- a-1 a-2))))))

(leetcode minimizeSum
          (, (, [1 4 7 8 5])
             3)
          (, (, [1 4 3])
             0))
