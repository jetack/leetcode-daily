(require lispy.macros *)
(require leetcode *)

(from leetcode *)

(def solution [nums]
  (nums.sort)
  (= a0 (sub nums 0))
  (= a1 (sub nums 1))
  (= a2 (sub nums 2))
  (= a-1 (sub nums -1))
  (= a-2 (sub nums -2))
  (= a-3 (sub nums -3))
  (return (- a-1
             a0
             (max (- a2 a0)
                  (- a-1 a-3)
                  (+ (- a1 a0)
                     (- a-1 a-2))))))

;; opus: only the 3 smallest and 3 largest matter, so pick them in O(n) instead of sorting
(def solution [nums]
  (= [a0 a1 a2] (nsmallest 3 nums))
  (= [z0 z1 z2] (nlargest 3 nums))
  (return (min (- z0 a2)
               (- z1 a1)
               (- z2 a0))))

(leetcode minimizeSum
          (, (, [1 4 7 8 5])
             3)
          (, (, [1 4 3])
             0))
