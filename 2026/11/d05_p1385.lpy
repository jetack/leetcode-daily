(require lispy.macros *)
(require leetcode *)

(from bisect [bisect-left bisect-right])

(from leetcode *)

(def solution [arr1 arr2 d]
  (arr2.sort)

  (def checker [n]
    (return (ife (< (bisect-left arr2 (- n d))
                     (bisect-right arr2 (+ n d)))
                 0
                 1)))
  
  (= rst 0)
  (for n arr1
    (+= rst (checker n)))
  (return rst))

(leetcode findTheDistanceValue
          [(, [4,5,8], [10,9,1,8], 2)
           2])
