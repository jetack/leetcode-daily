(require lispy.macros *)
(require leetcode *)

(from leetcode *)

(from heapq [heappop heappush])
(from collections [defaultdict])

(class SlidingMedian []
  (def __init__ [self]
    (= self.lower [])
    (= self.upper [])
    (= self.delayed (defaultdict int))

    (= self.lower-size 0)
    (= self.lower-sum 0)
    (= self.upper-size 0)
    (= self.upper-sum 0))

  (def lower-prune [self]
    (while self.lower
      (= value (- (sub self.lower 0)))
      (when (== (sub self.delayed value) 0)
        (break))
      (heappop self.lower)
      (-= (sub self.delayed value) 1)))

  (def upper-prune [self]
    (while self.upper
      (= value (sub self.upper 0))
      (when (== (sub self.delayed value) 0)
        (break))
      (heappop self.upper)
      (-= (sub self.delayed value) 1)))

  (def rebalance [self]
    (cond (> self.lower-size (inc self.upper-size))
          (do
            (= value (- (heappop self.lower)))
            (self.lower-prune)

            (-= self.lower-size 1)
            (-= self.lower-sum value)
            (+= self.upper-size 1)
            (+= self.upper-sum value)

            (heappush self.upper value))

          (< self.lower-size self.upper-size)
          (do
            (= value (heappop self.upper))
            (self.upper-prune)

            (-= self.upper-size 1)
            (-= self.upper-sum value)
            (+= self.lower-size 1)
            (+= self.lower-sum value)

            (heappush self.lower (- value)))))

  (def add [self value]
    (if (or (not self.lower)
            (<= value (- (sub self.lower 0))))
        (do
          (heappush self.lower (- value))
          (+= self.lower-size 1)
          (+= self.lower-sum value))
        (do
          (heappush self.upper value)
          (+= self.upper-size 1)
          (+= self.upper-sum value)))
    (self.rebalance))

  (def remove [self value]
    (+= (sub self.delayed value) 1)

    (if (<= value (- (sub self.lower 0)))
        (do
          (-= self.lower-size 1)
          (-= self.lower-sum value)

          (when (== value (- (sub self.lower 0)))
            (self.lower-prune)))
        (do
          (-= self.upper-size 1)
          (-= self.upper-sum value)

          (when (== value (sub self.upper 0))
            (self.upper-prune))))
    (self.rebalance))

  (def cost [self]
    (= med (- (sub self.lower 0)))

    (return (+ (- (* med self.lower-size) self.lower-sum)
               (- self.upper-sum (* med self.upper-size))))))


(def solution [nums x k]
  (= n (len nums))

  (= sm (SlidingMedian))

  (for i (range x)
    (sm.add (sub nums i)))

  (= precalc [(sm.cost)])
  (for i (range x n)
    (sm.remove (sub nums (- i x)))
    (sm.add (sub nums i))
    (.append precalc (sm.cost)))

  (= inf (float "inf"))

  (= mem [[inf for j in (range (+ k 1))]
          for i in (range (+ n 1))])

  (for i in (range (+ n 1))
    (= (sub mem i 0) 0))

  (for j in (range 1 (inc k))
    (for i in (range (* x (dec j)) (inc (- n x)))
      (= (sub mem (+ i x) j) (min (+ (sub mem i (dec j)) (sub precalc i))
                                  (sub mem (+ i x -1) j)))))
  
  (return (sub mem n k))
  )

(leetcode minOperations
          [(, [5,-2,1,3,7,3,6,4,-1] 3 2)
           8]
          )
