(require lispy.macros *)
(require leetcode *)

(from leetcode *)

(from heapq [heapify heappush heappop])

(def solution [k arrival load]
  (= afteri (list (range k)))
  (heapify afteri)
  (= beforei [])
  (= busy [])
  (= counter (* [0] k))
  (= requests (zip arrival load))

  (for [i [a l]] in (enumerate requests)
    ;; remainder
    (%= i k)

    ;; reinstate free worker
    (while (and busy
                (<= (sub busy 0 0) a))
      (= j (sub (heappop busy) 1))
      (if (>= j i)
          (heappush afteri j)
          (heappush beforei j)))

    ;; all busy: skip
    (when (and (not afteri)
               (not beforei))
      (continue))
    
    ;; rebalance
    (while (and afteri
                (< (sub afteri 0) i))
      (heappush beforei (heappop afteri)))
    (while (and beforei
                (>= (sub beforei 0) i))
      (heappush afteri (heappop beforei)))

    ;; pick worker
    (if afteri
        (= w (heappop afteri))
        (= w (heappop beforei)))

    ;; dispatch worker
    (+= (sub counter w) 1)
    (heappush busy [(+ a l) w]))

  (= max-tasks (max counter))

  (return [i for i in (range k) if (== max-tasks (sub counter i))]))

(leetcode busiestServers
          (, (, 3 [1 2 3 4 5] [5 2 3 3 3])
             [1])
          (, (, 3 [1 2 3 4] [1 2 1 2])
             [0])
          (, (, 3 [1 2 3] [10 12 11])
             [0 1 2]))
