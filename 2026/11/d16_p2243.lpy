(require lispy.macros *)
(require leetcode *)

(from leetcode *)

(def solution [s k]
  (while (> (len s) k)
    (= s (->> [(sub s [: i (+ i k)]) for i in (range 0 (len s) k)]
              (map (fn [x] (-> (map int x)
                               (sum)
                               (str))))
              (.join ""))))
  
  (return s))

(leetcode digitSum
          (, (, "11111222223" 3)
             "135")
          (, (, "00000000" 3)
             "000"))
